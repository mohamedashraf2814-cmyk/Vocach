{
  "name": "vocach",
  "private": true,
  "version": "1.0.0",
  "description": "نظام إدارة التحويلات المالية ونقاط البيع ومخزون إكسسوارات الموبايل",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "TZ=${TZ:-Africa/Cairo} node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "TZ=${TZ:-Africa/Cairo} NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@noble/hashes": "^1.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "buffer": "^6.0.3",
    "sql.js": "^1.11.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  }
}
